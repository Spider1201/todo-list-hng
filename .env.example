# Copy this file to `.env.local` for local development.
#
#   Copy-Item .env.example .env.local
#
# Never commit real values: `.env` and `.env.*` are gitignored (except this file).
# On Vercel, set the same keys in Project Settings -> Environment Variables
# for the Production, Preview and Development environments.

# Postgres connection string used by the app at runtime and by drizzle-kit.
# Use a POOLED connection string (Neon `-pooler` host, Supabase port 6543,
# or Vercel Postgres `POSTGRES_PRISMA_URL`).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/todo_app?sslmode=require"

# Separate database used ONLY by `npm test`. Tests that need a database are
# skipped when this key is missing, so the unit suite still runs without one.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/todo_app_test?sslmode=require"
